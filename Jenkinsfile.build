pipeline {
    agent any
    
    environment {
        IMAGE_NAME = "abode-webapp"
    }
    
    stages {
        stage('Build Docker Image') {
            steps{
                sh 'docker rmi $IMAGE_NAME'
                sh 'docker build -t $IMAGE_NAME .'
            }
        }
    }
    
    post {
        success {
            build job: 'test'
        }
    }
}
